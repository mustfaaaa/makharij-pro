{
  // So VS Code picks the backend's own virtualenv for IntelliSense, imports
  // and the test runner -- without this it falls back to the system Python,
  // where none of the backend's dependencies exist and every import is
  // underlined in red.
  "python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["backend/tests"],

  "python.analysis.extraPaths": ["${workspaceFolder}/backend"],

  // The reciter audio is ~600 MB of small files; leaving it searchable makes
  // the file watcher and every Ctrl+P noticeably slower.
  "files.watcherExclude": {
    "**/backend/app/static/recitations/**": true,
    "**/ml/data/**": true,
    "**/backend/.venv/**": true
  },
  "search.exclude": {
    "**/backend/app/static/recitations/**": true,
    "**/ml/data/**": true,
    "**/backend/.venv/**": true
  }
}

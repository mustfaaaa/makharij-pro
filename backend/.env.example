# Copy this file to backend/.env and fill in the values. backend/.env is
# git-ignored; this example is the only env file that is committed.

# Rattil AI assistant -- a free key from https://aistudio.google.com/apikey
# Leave empty to keep the assistant off; Rattil still understands requests
# with its built-in, rule-based reader.
GEMINI_API_KEY=

# Optional. Any free-tier Gemini model id.
GEMINI_MODEL=gemini-3.8-flash

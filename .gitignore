# Evaluation corpus. Not a choice: the three parquet shards are ~400 MB each
# and GitHub rejects any file over 100 MB, so these cannot be pushed without
# Git LFS. Reproducible from ml/eval/README.md in one command.
ml/data/

# Cross-model eval working directory: word-slice WAVs (thousands, regenerable
# from the stage1_*.py scripts) and run logs. The harness scripts and their
# small JSON summaries are kept; the audio and logs are not.
ml/eval/crossmodel/out/
ml/eval/crossmodel/out_qari/
ml/eval/crossmodel/out_qari_left*/
ml/eval/crossmodel/*.log
ml/eval/crossmodel/log_*.txt

# Eval run logs (the JSON summaries next to them are the durable record).
ml/eval/results/*.log

# Full-Quran reference audio fetched for evaluation (~1 GB, regenerable via
# ml/tools/fetch_full_quran_reference.py).
ml/data/reference_full/

# Reciter audio. The fifteen surahs the repository ships are already tracked, and
# gitignore does not apply to tracked files, so this only stops *new* audio from
# being committed -- one reciter's complete Quran is ~593 MB and is regenerable:
# ml/tools/fetch_full_quran_reference.py downloads it, and
# ml/tools/sync_qari_availability.py then tells the API which surahs are present.
backend/app/static/recitations/**/*.mp3

# Scratch markers the eval harnesses drop to signal completion.
ml/eval/**/*_DONE

# Evaluation-only venv for the candidate recogniser (ml/tools/README or the
# plan explains why it is separate from the backend venv).
ml/.venv-muaalem/

# Candidate recogniser weights (2.4 GB, MIT, obadx/muaalem-model-v3_2).
# Re-fetchable with ml/tools/fetch_muaalem_model.sh
ml/models/muaalem-v3_2/

# Decode caches for the recogniser comparison -- regenerated by the scripts
# themselves, and large enough to be noise in a diff.
ml/eval/results/current_predictions.jsonl

# Cached encoder activations for learner fine-tuning: ~350 MB, regenerated by
# ml/train/cache_encoder_features.py
ml/train/cache/
ml/train/*_DONE
ml/train/*.log

# Tuned head weights: a byproduct, rebuilt in a minute by
# ml/train/finetune_phoneme_head.py from the cached encoder features.
ml/train/weights/
ml/train/phoneme_head_learner.pt
